#!/bin/bash -l
#SBATCH --job-name=biogeme-h04-preflight
#SBATCH --chdir=/home/bierlair/github/biogeme
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=28G
#SBATCH --time=01:00:00
#SBATCH --partition=standard
#SBATCH --qos=serial
#SBATCH --output=slurm-%x-%j.out
#SBATCH --error=slurm-%x-%j.err

set -euo pipefail

export BIOGEME_REPOSITORY=/home/bierlair/github/biogeme
export BIOGEME_H04_RUN_ROOT="/scratch/$USER/biogeme-h04/$(git rev-parse HEAD)/preflight"
export BIOGEME_H04_NUMBER_OF_DRAWS=1000
export BIOGEME_H04_MAX_ITERATIONS=3

exec docs/source/examples/hybrid_choice_models/jed/run_h04.sh
